# Set these in Coolify's environment variable UI for the production/dev app
# (do not commit an actual .env with real values).

# Postgres
POSTGRES_USER=familytree
POSTGRES_PASSWORD=change-me

# Host port the web (nginx + frontend) service binds to. Give production and dev
# different values so both can run on the same server without conflicting.
#   production: WEB_PORT=8081
#   dev:        WEB_PORT=8082
WEB_PORT=8081

# This app's public URL. Frontend and API share this one origin.
#   production (Tailscale Funnel): https://<your-node-name>.<your-tailnet>.ts.net
#   dev (tailnet-only, not funneled): http://<your-node-name>.<your-tailnet>.ts.net:8082
PUBLIC_URL=https://your-node-name.your-tailnet.ts.net

# Optional: only needed if you turn on SuperTokens' API key check.
# SUPERTOKENS_API_KEY=
